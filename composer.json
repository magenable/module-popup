{
    "name": "magenable/module-popup",
    "description": "A Magento 2 popup module with newsletter feature",
    "require": {
        "magento/framework": ">=102.0",
        "magenable/module-base": "*"
    },
    "type": "magento2-module",
    "version": "1.0.8",
    "license": "MIT",
    "authors": [
        {
            "name": "Magenable",
            "homepage": "https://magenable.com.au"
        }
    ],
    "keywords": [
        "magento 2 popup newsletter",
        "popup",
        "newsletter"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magenable\\Popup\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
